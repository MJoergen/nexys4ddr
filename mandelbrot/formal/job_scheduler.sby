## Formal verification of job_scheduler.vhd.
##
## Task naming:  <mode>_<G_SIZE>_<G_GROUP_SIZE>
##
##   7_3  - Three groups, where the last one has a single process.
##   5_16 - A single group, which is not full. Five processes is the least
##          the dispatcher allows.
##   8_2  - Four full groups.
##
## Run one task:   sby --yosys "yosys -m ghdl" -f job_scheduler.sby prove_7_3
## Run everything: sby --yosys "yosys -m ghdl" -f job_scheduler.sby

[tasks]
cover_7_3   cover  s7_3
prove_7_3   prove  s7_3
cover_5_16  cover  s5_16
prove_5_16  prove  s5_16
cover_8_2   cover  s8_2
prove_8_2   prove  s8_2

[options]
cover: mode cover
cover: depth 20
prove: mode prove
prove: depth 12

[engines]
smtbmc

[script]
s7_3:  ghdl --std=08 -gG_SIZE=7 -gG_GROUP_SIZE=3  job_scheduler.vhd job_scheduler.psl -e job_scheduler
s5_16: ghdl --std=08 -gG_SIZE=5 -gG_GROUP_SIZE=16 job_scheduler.vhd job_scheduler.psl -e job_scheduler
s8_2:  ghdl --std=08 -gG_SIZE=8 -gG_GROUP_SIZE=2  job_scheduler.vhd job_scheduler.psl -e job_scheduler
prep -top job_scheduler

[files]
job_scheduler.psl
../src/main/job_scheduler.vhd
