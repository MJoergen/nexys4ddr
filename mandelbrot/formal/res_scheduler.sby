## Formal verification of res_scheduler.vhd.
##
## Task naming:  <mode>_<G_SIZE>_<G_GROUP_SIZE>
##
##   7_3  - Three groups, where the last one has a single process. There are
##          fewer than five groups, so the counter has empty positions.
##   4_16 - A single group, which is not full.
##   12_2 - Six groups, so the counter has no empty positions.
##
## The induction depth must be larger than the longest time a process waits
## (C_MAX_WAIT in res_scheduler.psl, 22 for 4_16), because f_wait_a is only
## proved by the induction, without any invariant about the order within the
## groups.
##
## Run one task:   sby --yosys "yosys -m ghdl" -f res_scheduler.sby prove_7_3
## Run everything: sby --yosys "yosys -m ghdl" -f res_scheduler.sby

[tasks]
cover_7_3   cover  s7_3
prove_7_3   prove  s7_3
cover_4_16  cover  s4_16
prove_4_16  prove  s4_16
cover_12_2  cover  s12_2
prove_12_2  prove  s12_2

[options]
cover: mode cover
cover: depth 40
prove: mode prove
prove: depth 30

[engines]
smtbmc

[script]
s7_3:  ghdl --std=08 -gG_SIZE=7  -gG_GROUP_SIZE=3  res_scheduler.vhd res_scheduler.psl -e res_scheduler
s4_16: ghdl --std=08 -gG_SIZE=4  -gG_GROUP_SIZE=16 res_scheduler.vhd res_scheduler.psl -e res_scheduler
s12_2: ghdl --std=08 -gG_SIZE=12 -gG_GROUP_SIZE=2  res_scheduler.vhd res_scheduler.psl -e res_scheduler
prep -top res_scheduler

[files]
res_scheduler.psl
../src/main/res_scheduler.vhd
